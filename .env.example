# Database URL (optional - the app runs in demo mode without it)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-minimum-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Email (optional for lead notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
MAIL_TO="info@dachnye-domiki-bytovki.ru"

# Super Admin credentials (first-time login)
SUPER_ADMIN_EMAIL="a@gmail.com"
SUPER_ADMIN_PASSWORD="123"

# Demo login used by lib/auth.ts when DATABASE_URL is absent (hosted preview).
# Without these two the demo build has no way to sign in at all.
DEMO_ADMIN_EMAIL="a@gmail.com"
DEMO_ADMIN_PASSWORD="123"

# Public brand info
NEXT_PUBLIC_SITE_URL="https://dachnye-domiki-bytovki.vercel.app"
