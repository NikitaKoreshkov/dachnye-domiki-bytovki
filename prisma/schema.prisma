generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String // Хранится хеш, не пароль
  name          String?
  image         String?
  emailVerified DateTime?
  isActive      Boolean   @default(false) // Активен ли аккаунт после верификации email
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  // verificationCodes VerificationCode[]

  favorites       Project[]          @relation("UserFavorites")
  compareProjects Project[]          @relation("UserCompare")
  documents       EstimateDocument[]
  leads           WhatsAppLead[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique // URL-friendly ID для маршрутизации (например: skandy-140)
  title       String
  area        Int
  priceFrom   Int
  priceTo     Int?
  floors      Float
  material    String // 'каркасный' | 'SIP' | 'комбинированный'
  buildTime   Int // в днях
  completion  String // 'под ключ' | 'тёплый контур' | 'коробка'
  region      String
  image       String
  images      String[] @default([]) // массив путей к изображениям
  tags        String[] @default([])
  hasTerrasse Boolean  @default(false)
  hasBath     Boolean  @default(false)
  hasGarage   Boolean  @default(false)
  features    String[] @default([])
  description String?  @db.Text
  advantages  String[] @default([])
  technicalSpecs String? @db.Text // Технические характеристики в виде простого текста
  specs       Json? // технические характеристики в формате JSON
  filterValues Json? // значения для динамических фильтров каталога { "filterKey": value }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favoritedBy User[] @relation("UserFavorites")
  comparedBy  User[] @relation("UserCompare")

  @@index([slug])
  @@index([region])
  @@index([material])
  @@index([completion])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model EstimateDocument {
  id        String   @id @default(uuid())
  userId    String
  title     String
  params    Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model WhatsAppLead {
  id        String   @id @default(uuid())
  name      String?
  phone     String?
  message   String?  @db.Text
  params    Json?
  purpose   String?
  source    String? // e.g. calculator, contact_form
  projectId String?
  createdAt DateTime @default(now())
  userId    String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Популярные проекты: до 2 панелей, каждая до 6 элементов
model PopularPanel {
  id        String        @id @default(uuid())
  title     String
  order     Int           @default(0)
  items     PopularItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model PopularItem {
  id          String   @id @default(uuid())
  panelId     String
  title       String
  area        Int
  priceFrom   Int
  priceTo     Int?
  floors      Float    @default(1)
  material    String // 'каркасный' | 'SIP' | 'комбинированный'
  buildTime   Int      @default(30) // в днях
  completion  String   @default("под ключ") // 'под ключ' | 'тёплый контур' | 'коробка'
  region      String   @default("Москва")
  image       String
  images      String[] @default([]) // массив путей к изображениям
  tags        String[] @default([])
  hasTerrasse Boolean  @default(false)
  hasBath     Boolean  @default(false)
  hasGarage   Boolean  @default(false)
  features    String[] @default([])
  description String?  @db.Text
  advantages  String[] @default([])
  technicalSpecs String? @db.Text // Технические характеристики в виде простого текста
  specs       Json? // технические характеристики в формате JSON
  filterValues Json? // значения для динамических фильтров каталога { "filterKey": value }
  order       Int      @default(0)
  slug        String?  @unique // Уникальный slug для популярного проекта (если нет связи с реальным проектом)
  projectSlug String? // Опциональная связь с реальным проектом (если нужна)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  panel PopularPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, order])
  @@index([projectSlug])
  @@index([slug])
}

// Отзывы
model Review {
  id        String   @id @default(uuid())
  name      String
  city      String
  text      String   @db.Text
  image     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Конфиг блока отзывов
model ReviewsConfig {
  id            String   @id @default(uuid())
  title         String   @default("Реальные фото и отзывы наших клиентов")
  description   String   @db.Text @default("Мы собрали часть отзывов — чтобы вы могли увидеть, как строим дома на практике.\n\nОстальные отзывы можно посмотреть по запросу или в наших соцсетях.")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Часто задаваемые вопросы
model FAQItem {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Конфиг калькулятора и шаблонов как единый JSON
model CalculatorConfig {
  id                String   @id @default(uuid())
  houseTypes        Json // [{id,name,basePrice,image}]
  finishingOptions  Json // [{id,name,multiplier}]
  additionalOptions Json // [{id,name,price}]
  stepTexts         Json // {step1Title, step2Title, step3Title, step4Title}
  areaSettings      Json? // {minArea, maxArea, defaultArea}
  formula           String // js-like expression or description
  whatsappTemplate  String   @db.Text
  estimateTemplate  String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Конфиг фильтров каталога (JSON с блоками и опциями)
model CatalogFiltersConfig {
  id        String   @id @default(uuid())
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Конфиг хедера сайта
model HeaderConfig {
  id            String   @id @default(uuid())
  logoText      String   @default("Дачные-Домики-Бытовки")
  logoImage     String?
  showLogoText  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

